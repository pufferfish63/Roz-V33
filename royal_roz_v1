local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- Anti-Lag Ultra (no sound mute, but max visual clean)
local function ultraAntiLag()
    -- Disable particles & effects
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
            obj.Enabled = false
        end
    end

    -- Lighting minimal
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 1e6
    Lighting.Brightness = 1
    Lighting.OutdoorAmbient = Color3.new(1,1,1)
    settings().Rendering.QualityLevel = "Level01"
    RunService:Set3dRenderingEnabled(true)
end

-- Basic Aimbot, locks to nearest HumanoidRootPart within 60 studs
local aimbotEnabled = false
local AIM_RADIUS = 60

local function getClosestEnemy()
    local closest, dist = nil, math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local targetPos = player.Character.HumanoidRootPart.Position
            local myPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position
            if myPos then
                local d = (targetPos - myPos).Magnitude
                if d < dist and d <= AIM_RADIUS then
                    dist = d
                    closest = player
                end
            end
        end
    end
    return closest
end

-- Aura effect: glowy box around local player root part
local auraBox = nil
local function toggleAura(state)
    if state then
        if not auraBox then
            auraBox = Instance.new("SelectionBox")
            auraBox.Adornee = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            auraBox.Color3 = Color3.fromRGB(255, 215, 0) -- royal gold
            auraBox.LineThickness = 0.12
            auraBox.Parent = workspace
        end
    else
        if auraBox then
            auraBox:Destroy()
            auraBox = nil
        end
    end
end

