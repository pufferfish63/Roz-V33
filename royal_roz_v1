-- Toggle helper function
local function createToggle(text, posY, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -20, 0, 40)
    frame.Position = UDim2.new(0, 10, 0, posY)
    frame.BackgroundTransparency = 0.5
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.BorderSizePixel = 0
    frame.Parent = MainFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 18
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 60, 0, 30)
    toggleBtn.Position = UDim2.new(1, -70, 0, 5)
    toggleBtn.BackgroundColor3 = default and Color3.fromRGB(34,139,34) or Color3.fromRGB(184,134,11)
    toggleBtn.Text = default and "ON" or "OFF"
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.TextColor3 = Color3.new(1,1,1)
    toggleBtn.TextSize = 16
    toggleBtn.Parent = frame

    local toggled = default

    toggleBtn.MouseButton1Click:Connect(function()
        toggled = not toggled
        toggleBtn.BackgroundColor3 = toggled and Color3.fromRGB(34,139,34) or Color3.fromRGB(184,134,11)
        toggleBtn.Text = toggled and "ON" or "OFF"
        callback(toggled)
    end)

    return frame, toggleBtn
end

-- Toggles
local fpsBoost = false
local antiLag = true
local aura = false

createToggle("FPS Boost 60 / 90", 90, fpsBoost, function(state)
    fpsBoost = state
    if fpsBoost then
        settings().Rendering.QualityLevel = "Level02" -- 90fps
    else
        settings().Rendering.QualityLevel = "Level01" -- 60fps
    end
end)

createToggle("Extreme AntiLag", 140, antiLag, function(state)
    antiLag = state
    if antiLag then
        ultraAntiLag()
    else
        -- Restore default lighting settings
        Lighting.GlobalShadows = true
        Lighting.FogEnd = 1000
        Lighting.Brightness = 2
        Lighting.OutdoorAmbient = Color3.new(0.5,0.5,0.5)
        RunService:Set3dRenderingEnabled(true)
        settings().Rendering.QualityLevel = "Level03"
    end
end)

createToggle("Aura Effect", 190, aura, function(state)
    aura = state
    toggleAura(aura)
end)

-- Aimbot toggle
local aimbotToggle = false
createToggle("Aimbot", 240, aimbotToggle, function(state)
    aimbotToggle = state
end)

-- Main Loop
RunService.Heartbeat:Connect(function()
    if antiLag then
        ultraAntiLag()
    end

    if aimbotToggle then
        local target = getClosestEnemy()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then
                -- Aim at target smoothly by moving mouse hit (hacky)
                local targetPos = target.Character.HumanoidRootPart.Position
                Mouse.Hit = CFrame.new(targetPos)
            end
        end
    end
end)
